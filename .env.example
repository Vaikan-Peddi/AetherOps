PROJECT_NAME=AetherOps
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aetherops
POSTGRES_DB=aetherops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=aetherops_document_chunks
STORAGE_DIR=/app/storage
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=6
RAG_RERANK_TOP_K=5

DEFAULT_LLM_PROVIDER=ollama
ENABLED_LLM_PROVIDERS=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_RAG_MODEL=llama3.1:8b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_SUMMARIZATION_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_GATEWAY_FALLBACK_PROVIDER=ollama
LLM_REQUEST_TIMEOUT_SECONDS=90
RATE_LIMIT_REQUESTS_PER_MINUTE=120

VITE_API_BASE_URL=http://localhost:8000/api/v1
