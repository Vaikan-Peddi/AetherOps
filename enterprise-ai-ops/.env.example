PROJECT_NAME=AetherOps
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aetherops
POSTGRES_DB=aetherops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=aetherops_document_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=150

DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_REQUEST_TIMEOUT_SECONDS=90

VITE_API_BASE_URL=http://localhost:8000/api/v1
